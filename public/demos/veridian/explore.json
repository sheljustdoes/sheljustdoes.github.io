   ],
   "findings": [
    {
     "pmid": "41821769",
     "text": "Animal studies have consistently shown that metformin extends both lifespan and healthspan.",
     "section": "RESULTS"
    },
    {
     "pmid": "41821769",
     "text": "In humans, retrospective epidemiological data indicate reduced incidence of cancer, cardiovascular disease, and cognitive decline among metformin users.",
     "section": "RESULTS"
    }
   ]
