{
  "name": "sheljustdoes.github.io",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "postbuild": "node scripts/check-projects.mjs && node scripts/resume-sync.test.mjs && node scripts/locked.mjs check && node scripts/protect.mjs",
    "start": "next start",
    "lint": "next lint",
    "preview": "next build && npx --yes http-server out -p 3502 -s -c-1 -o",
    "check": "next build && npx --yes tsc --noEmit",
    "test:ui": "python scripts/ui-smoke.py",
    "locked:pull": "node scripts/locked.mjs pull",
    "locked:push": "node scripts/locked.mjs push",
    "locked:status": "node scripts/locked.mjs status"
  },
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-color": "^3.1.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.5.0",
    "world-atlas": "^2.0.2"
  }
